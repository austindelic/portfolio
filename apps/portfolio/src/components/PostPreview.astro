---
const { post } = Astro.props;

const dateFormat = new Intl.DateTimeFormat("en-AU", {
	day: "numeric",
	month: "short",
	year: "numeric",
});

function getFormattedDate(date: string | number | Date) {
	return dateFormat.format(new Date(date));
}

const date = new Date(post.data.publishDate);
const datetime = date.toISOString();
const postDate = getFormattedDate(date);
---

<a class="post-row" href={`/blog/${post.slug}/`}>
  <time datetime={datetime}>{postDate}</time>
  <div><span class="row-title">{post.data.title}</span><p class="row-description">{post.data.description}</p></div>

</a>
