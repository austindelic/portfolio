---
import type { Props } from "./BlackHoleCore";
const props: Props = Astro.props;
---
<div data-black-hole-background data-settings={JSON.stringify(props)} transition:persist="black-hole-background" class={`relative h-full w-full bg-black ${props.className ?? ""}`}>
  <canvas class="block h-full w-full bg-black pointer-events-none" aria-label="Interactive black hole shader"></canvas>
  <div data-black-hole-error hidden class="absolute inset-x-4 bottom-4 border border-red-500/60 bg-black/85 p-3 font-mono text-xs text-red-200"></div>
</div>
<script>
import {createRuntimeState, mountBlackHoleRuntime, runtimeOptions} from "./BlackHoleRuntime";
import { bindBlackHoleExplore } from "./BlackHoleExplore";
import type {Props} from "./BlackHoleCore";
let host: HTMLElement | null = null;
let runtime: ReturnType<typeof mountBlackHoleRuntime> | undefined;
let previousRoute = "";
let unbindExplore: (() => void) | undefined;
function syncBackground() {
 unbindExplore?.();
 const next = document.querySelector<HTMLElement>("[data-black-hole-background]");
 if (host !== next) {
   runtime?.dispose(); runtime = undefined; host = next;
   if (host) {
     const props: Props = JSON.parse(host.dataset.settings!);
     const error = host.querySelector<HTMLElement>("[data-black-hole-error]")!;
     runtime = mountBlackHoleRuntime(host.querySelector("canvas")!, createRuntimeState(props), runtimeOptions(props, message => {
       error.textContent = message ?? ""; error.hidden = !message;
     }));
     previousRoute = location.pathname;
   }
 } else if (runtime && previousRoute !== location.pathname) {
   runtime.updateRoute(location.pathname);
   previousRoute = location.pathname;
 }
 unbindExplore = bindBlackHoleExplore(() => runtime);
}
syncBackground();
document.addEventListener("astro:page-load", syncBackground);
document.addEventListener("astro:before-swap", (event) => {
 unbindExplore?.();
 const nextDocument = (event as Event & {newDocument: Document}).newDocument;
 if (!nextDocument.querySelector("[data-black-hole-background]")) {
   runtime?.dispose(); runtime = undefined; host = null;
 }
});
window.addEventListener("pagehide", event => { if (!event.persisted) { runtime?.dispose(); runtime = undefined; host = null; } });
</script>
