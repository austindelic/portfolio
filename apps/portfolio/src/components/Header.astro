---
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this prop in the template.
const { navbarActiveItemID, disableClock = false } = Astro.props;

// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { SquareArrowOutUpRight } from "lucide-react";

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const links: Array<{
	title: string;
	id?: string;
	url?: string;
	new?: boolean;
	redirect?: string;
}> = [
	{
		title: "home",
		id: "home",
		url: "/",
	},
	{
		title: "blog",
		id: "blog",
		url: "/blog",
	},
	{
		title: "socials",
		id: "socials",
		url: "/socials",
	},

	{ title: "resume", id: "resume", url: "/resume.pdf" },
];
---

<header transition:name="portfolio-header" data-disable-clock={disableClock ? "true" : "false"} id="main-header" class="portfolio-header">
  <nav
    id="navigation-menu"
    aria-label="Main menu"
    class="portfolio-navigation"
  >
    <span class="clock-label">
      <span class="clock-caption">PERTH /</span> <a href="/" target="_self" class="text-foreground font-medium text-md">
        <span id="perth-time" aria-label="Current time in Perth">
          <span data-clock-hour>--</span><span class="clock-colon" data-clock-colon>:</span><span data-clock-minute>--</span><span class="clock-colon" data-clock-colon>:</span><span data-clock-second>--</span>
        </span>
      </a>
    </span>
    <span class="navigation-links">
      {
        links.map((link) => {
          const isActive = link.id === navbarActiveItemID;

          return (
            <a
              href={link.redirect ? link.redirect : link.url}
              target={link.redirect ? "_blank" : "_self"}
              id={link.id}
              aria-current={isActive ? "page" : undefined}
              class="nav-link inline-flex items-center gap-1"
            >
              {link.title}
              {!isActive && (
                <SquareArrowOutUpRight
                  className="h-[1em] w-[1em] shrink-0"
                  aria-hidden="true"
                />
              )}
            </a>
          );
        })
      }
    </span>
  </nav>
</header>

<script>
  const formatter = new Intl.DateTimeFormat("en-AU", {
    timeZone: "Australia/Perth", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false,
  });
  let interval: ReturnType<typeof setInterval> | undefined;
  function stopClock() {
    if (interval !== undefined) window.clearInterval(interval);
    interval = undefined;
  }
  function setupClock() {
    stopClock();
    const clock = document.getElementById("perth-time");
    if (!clock || document.getElementById("main-header")?.dataset.disableClock === "true") return;
    const hour = clock.querySelector("[data-clock-hour]");
    const minute = clock.querySelector("[data-clock-minute]");
    const second = clock.querySelector("[data-clock-second]");
    const colons = clock.querySelectorAll("[data-clock-colon]");
    function updateText(node: Element | null, value: string) {
      if (node && node.textContent !== value) node.textContent = value;
    }
    function update() {
      const now = new Date();
      for (const part of formatter.formatToParts(now)) {
        if (part.type === "hour") updateText(hour, part.value);
        if (part.type === "minute") updateText(minute, part.value);
        if (part.type === "second") updateText(second, part.value);
      }
      for (const colon of colons) colon.classList.toggle("off", now.getSeconds() % 2 !== 0);
    }
    update();
    interval = window.setInterval(update, 1000);
  }
  setupClock();
  document.addEventListener("astro:before-swap", stopClock);
  document.addEventListener("astro:page-load", setupClock);
</script>
