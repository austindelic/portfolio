---
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this prop in the template.
const { navbarActiveItemID, disableClock = false } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Astro passes this value into the inline script.
const activeClasses = ["text-white", "opacity-100"];

// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { SquareArrowOutUpRight } from "lucide-react";

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const links: Array<{
	title: string;
	id?: string;
	url?: string;
	new?: boolean;
	redirect?: string;
}> = [
	{
		title: "home",
		id: "home",
		url: "/",
	},
	{
		title: "blog",
		id: "blog",
		url: "/blog",
	},
	{
		title: "socials",
		id: "socials",
		url: "/socials",
	},

	{ title: "resume", id: "resume", url: "/resume.pdf" },
];
---

<header id="main-header" class="mb-8 px-6 mt-6">
  <nav
    id="navigation-menu"
    aria-label="Main menu"
    class="flex flex-col lg:flex-row justify-between items-start lg:items-center"
  >
    <span class="mb-4 lg:mb-0">
      <a href="/" target="_self" class="text-white font-medium text-md">
        <span id="perth-time" aria-label="Current time in Perth">
          <span data-clock-hour>--</span><span class="clock-colon" data-clock-colon>:</span><span data-clock-minute>--</span><span class="clock-colon" data-clock-colon>:</span><span data-clock-second>--</span>
        </span>
      </a>
    </span>
    <span class="flex flex-wrap gap-6 text-sm">
      {
        links.map((link) => {
          const isActive = link.id === navbarActiveItemID;

          return (
            <a
              href={link.redirect ? link.redirect : link.url}
              target={link.redirect ? "_blank" : "_self"}
              id={link.id}
              class="text-gray-400 opacity-70 hover:opacity-100 inline-flex items-center gap-1"
            >
              {link.title}
              {!isActive && (
                <SquareArrowOutUpRight
                  className="h-[1em] w-[1em] shrink-0"
                  aria-hidden="true"
                />
              )}
            </a>
          );
        })
      }
    </span>
  </nav>
</header>

<script
  define:vars={{
    navbarActiveItemID,
    activeClasses,
    disableClock,
  }}
>
  const activeItemElement = document.getElementById(navbarActiveItemID);

  if (activeItemElement) {
    activeClasses.forEach((activeClass) => {
      activeItemElement.classList.add(activeClass);
    });
  }

  const clockWindow = window;
  const clock = document.getElementById("perth-time");
  const hour = clock?.querySelector("[data-clock-hour]");
  const minute = clock?.querySelector("[data-clock-minute]");
  const second = clock?.querySelector("[data-clock-second]");
  const colons = clock ? Array.from(clock.querySelectorAll("[data-clock-colon]")) : [];
  const formatter = new Intl.DateTimeFormat("en-AU", {
    timeZone: "Australia/Perth",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  });

  function updateText(node, value) {
    if (node && node.textContent !== value) node.textContent = value;
  }

  function updatePerthTime() {
    const now = new Date();
    const parts = formatter.formatToParts(now);

    let h = "", m = "", s = "";
    for (const p of parts) {
      if (p.type === "hour") h = p.value;
      if (p.type === "minute") m = p.value;
      if (p.type === "second") s = p.value;
    }

    updateText(hour, h);
    updateText(minute, m);
    updateText(second, s);

    const colonHidden = now.getSeconds() % 2 !== 0;
    for (const colon of colons) {
      colon.classList.toggle("off", colonHidden);
    }
  }

  if (clockWindow.__perthClockInterval) {
    window.clearInterval(clockWindow.__perthClockInterval);
    clockWindow.__perthClockInterval = undefined;
  }

  if (!disableClock) {
    updatePerthTime();
    clockWindow.__perthClockInterval = window.setInterval(updatePerthTime, 1000);
  }
</script>
