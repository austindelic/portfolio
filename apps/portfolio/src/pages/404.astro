---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Austin Delic" description="That page is gone, or the link is wrong. Head home or read the blog.">
  <section class="portfolio-section" aria-labelledby="error-heading">
    <div class="section-label"><span>Page not found</span><span>404</span></div>
    <h1 id="error-heading" class="page-title">Nothing here.</h1>
    <p class="error-copy">That page is gone, or the link is wrong.</p>
    <p class="page-intro"><a href="/">Head home</a> or <a href="/blog">read the blog</a>.</p>
  </section>
</BaseLayout>
