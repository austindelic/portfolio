---
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { MapPin } from "pixelarticons/react/MapPin.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Briefcase } from "pixelarticons/react/Briefcase.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Target } from "pixelarticons/react/Target.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Mail } from "pixelarticons/react/Mail.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Code } from "pixelarticons/react/Code.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Copy } from "pixelarticons/react/Copy.js";

import { getCollection } from "astro:content";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import PostPreview from "../components/PostPreview.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortMDByDate } from "../utils";

const allPosts = await getCollection("blog");
const visiblePosts = allPosts.filter((post) => post.data.published !== false);
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const allPostsByDate = sortMDByDate(visiblePosts);

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const techStack: Record<string, string> = {
	ts: "TypeScript",
	go: "Go",
	rust: "Rust",
	python: "Python",
	postgres: "Postgres",
	next: "Next.js",
	angular: "Angular",
	dotnet: ".NET",
	azure: "Azure",
};

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const projects: Array<{
	title: string;
	description: string;
	link: string;
	label: string;
}> = [
	{
		title: "Tactify",
		description:
			"AI accessibility platform for tactile SVG graphics and guided audio narration.",
		label: "product",
		link: "/blog/building-tactify/",
	},
	{
		title: "Still",
		description:
			"Rust project environment manager built around typed desired state.",
		label: "systems",
		link: "https://github.com/austindelic/still",
	},
	{
		title: "Production systems",
		description:
			"Notes from shipping across web, mobile, APIs, cloud, CI/CD, and support tooling.",
		label: "work",
		link: "/blog/production-systems-notes/",
	},
];
---

<BaseLayout navbarActiveItemID="home" contentPlacement="right">
  <section id="about" class="portfolio-section" aria-labelledby="about-heading">
    <div class="section-label"><span><span class="section-number">01 /</span> About</span><span>Perth, Australia</span></div>
    <div class="identity-grid"><div class="identity-copy">
    <div class="identity-heading"><svg class="pixel-mark" viewBox="0 0 13 7" aria-hidden="true"><path d="M1 0h3v1H1zM0 1h1v6H0zM4 1h1v6H4zM1 3h3v1H1zM7 0h4v1H7zM7 1h1v5H7zM11 1h1v5h-1zM7 6h4v1H7z" fill="currentColor"/></svg><h1 id="about-heading" class="intro-title">Austin Delic<span class="text-primary">.</span></h1></div>
    <p class="intro-subtitle">Software engineer / builder in Perth.</p>
    <p class="intro-copy">I build production software across web, mobile, backend systems, cloud infrastructure, and AI product surfaces. Recent work spans healthcare payments platforms, accessibility tooling, Rust developer infrastructure, and full-stack client products.</p>
    </div>
    <dl class="profile-details">
      <div><dt><MapPin className="ui-icon" aria-hidden="true" />Location</dt><dd>Perth, Australia</dd></div>
      <div><dt><Briefcase className="ui-icon" aria-hidden="true" />Work</dt><dd>Production full-stack engineering, AI products, systems tooling</dd></div>
      <div><dt><Target className="ui-icon" aria-hidden="true" />Focus</dt><dd>End-to-end ownership, reliable delivery, useful abstractions</dd></div>
      <div><dt><Mail className="ui-icon" aria-hidden="true" />Contact</dt><dd><a class="text-primary" href="mailto:austin@austindelic.com">austin@austindelic.com</a><button class="copy-email" type="button" aria-label="Copy email address" data-copy-email><Copy className="ui-icon" aria-hidden="true" /></button><span class="copy-status" role="status" aria-live="polite"></span></dd></div>
      <div><dt><Code className="ui-icon" aria-hidden="true" />Stack</dt><dd class="stack-list">{Object.entries(techStack).map(([key, label]) => <span title={label}>{key}</span>)}</dd></div>
    </dl></div>
  </section>
  <section id="projects" class="portfolio-section directory-panel" aria-labelledby="projects-heading">
    <div class="section-label"><h2 id="projects-heading"><span class="section-number">02 /</span> Project samples</h2><span>{String(projects.length).padStart(2, "0")}</span></div>
    <div class="directory-columns" aria-hidden="true"><span>Project</span><span>Category</span></div>
    <ul class="ruled-list project-list">
      {projects.map((project, index) => (
        <li><a class="project-row" href={project.link} target={project.link.startsWith("http") ? "_blank" : undefined} rel={project.link.startsWith("http") ? "noopener noreferrer" : undefined}>
          <span class="row-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div><span class="row-title">{project.title}</span><p class="row-description">{project.description}</p></div>
          <span class="row-category">{project.label}</span>
        </a></li>
      ))}
    </ul>
  </section>
  <section id="latest-posts" class="portfolio-section directory-panel" aria-labelledby="blog-heading">
    <div class="section-label"><h2 id="blog-heading"><span class="section-number">03 /</span> Latest posts</h2><a href="/blog">All posts</a></div>
    <ul class="ruled-list">{allPostsByDate.map((post) => <li><PostPreview post={post} /></li>)}</ul>
  </section>
</BaseLayout>

<script>
  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    if (!button || button.dataset.ready) return;
    button.dataset.ready = "true";
    button.addEventListener("click", async () => {
      const status = button.nextElementSibling;
      try {
        await navigator.clipboard.writeText("austin@austindelic.com");
        if (status) status.textContent = "Copied";
      } catch {
        if (status) status.textContent = "Copy unavailable — select the address.";
      }
      window.setTimeout(() => { if (status) status.textContent = ""; }, 2500);
    });
  }
  initCopyEmail();
  document.addEventListener("astro:page-load", initCopyEmail);
</script>
