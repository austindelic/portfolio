---
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { MapPin } from "pixelarticons/react/MapPin.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Briefcase } from "pixelarticons/react/Briefcase.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Target } from "pixelarticons/react/Target.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Mail } from "pixelarticons/react/Mail.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Code } from "pixelarticons/react/Code.js";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import { Copy } from "pixelarticons/react/Copy.js";

import portfolio from "../data/portfolio.json";
import { getCollection } from "astro:content";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import PostPreview from "../components/PostPreview.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortMDByDate } from "../utils";

const allPosts = await getCollection("blog");
const visiblePosts = allPosts.filter((post) => post.data.published !== false);
// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const allPostsByDate = sortMDByDate(visiblePosts);

// biome-ignore lint/correctness/noUnusedVariables: Astro consumes this value in the template.
const { profile, projects } = portfolio;
const techStack = profile.stack;
---

<BaseLayout navbarActiveItemID="home" contentPlacement="right">
  <section id="about" class="portfolio-section" aria-labelledby="about-heading">
    <div class="section-label"><span><span class="section-number">01 /</span> About</span><span>{profile.location}</span></div>
    <div class="identity-grid"><div class="identity-copy">
    <h1 id="about-heading" class="intro-title">{profile.name}<span class="text-primary">.</span></h1>
    <p class="intro-subtitle">{profile.subtitle}</p>
    <p class="intro-copy">{profile.bio}</p>
    </div>
    <dl class="profile-details">
      <div><dt><MapPin className="ui-icon" aria-hidden="true" />Location</dt><dd>{profile.location}</dd></div>
      <div><dt><Briefcase className="ui-icon" aria-hidden="true" />Work</dt><dd>{profile.work}</dd></div>
      <div><dt><Target className="ui-icon" aria-hidden="true" />Focus</dt><dd>{profile.focus}</dd></div>
      <div><dt><Mail className="ui-icon" aria-hidden="true" />Contact</dt><dd><a class="text-primary" href={`mailto:${profile.email}`}>{profile.email}</a><button class="copy-email" type="button" aria-label="Copy email address" data-copy-email><Copy className="ui-icon" aria-hidden="true" /></button><span class="copy-status" role="status" aria-live="polite"></span></dd></div>
      <div><dt><Code className="ui-icon" aria-hidden="true" />Stack</dt><dd class="stack-list">{Object.entries(techStack).map(([key, label]) => <span title={label}>{key}</span>)}</dd></div>
    </dl></div>
  </section>
  <section id="projects" class="portfolio-section directory-panel" aria-labelledby="projects-heading">
    <div class="section-label"><h2 id="projects-heading"><span class="section-number">02 /</span> Projects</h2><span>{String(projects.length).padStart(2, "0")}</span></div>
    <div class="directory-columns" aria-hidden="true"><span>Project</span><span>Category</span></div>
    <ul class="ruled-list project-list">
      {projects.map((project, index) => {
        const Tag = project.link ? "a" : "div";
        return (
        <li><Tag class="project-row" href={project.link} target={project.link?.startsWith("http") ? "_blank" : undefined} rel={project.link?.startsWith("http") ? "noopener noreferrer" : undefined}>
          <span class="row-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div><span class="row-title">{project.title}</span><p class="row-description">{project.description}</p></div>
          <span class="row-category">{project.label}</span>
        </Tag></li>
      ); })}
    </ul>
  </section>
  <section id="latest-posts" class="portfolio-section directory-panel" aria-labelledby="blog-heading">
    <div class="section-label"><h2 id="blog-heading"><span class="section-number">03 /</span> From the blog</h2><a href="/blog">All posts</a></div>
    <ul class="ruled-list">{allPostsByDate.map((post) => <li><PostPreview post={post} /></li>)}</ul>
  </section>
</BaseLayout>

<script>
  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    if (!button || button.dataset.ready) return;
    button.dataset.ready = "true";
    button.addEventListener("click", async () => {
      const status = button.nextElementSibling;
      try {
        await navigator.clipboard.writeText(button.previousElementSibling?.textContent ?? "");
        if (status) status.textContent = "Copied";
      } catch {
        if (status) status.textContent = "Couldn’t copy. Select the address to copy it.";
      }
      window.setTimeout(() => { if (status) status.textContent = ""; }, 2500);
    });
  }
  initCopyEmail();
  document.addEventListener("astro:page-load", initCopyEmail);
</script>
