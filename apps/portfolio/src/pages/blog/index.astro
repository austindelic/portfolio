---
import { getCollection } from "astro:content";
import PostPreview from "../../components/PostPreview.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sortMDByDate } from "../../utils";

const allPosts = await getCollection("blog");

const visiblePosts = allPosts.filter((post) => post.data.published !== false);
const allPostsByDate = sortMDByDate(visiblePosts);
---

<BaseLayout title="Blog" navbarActiveItemID="blog">
  <section class="portfolio-section directory-panel" aria-label="Blog posts">
    <div class="section-label"><span>Writing</span><span>Archive</span></div>
    <h1 class="page-title">Blog posts</h1>

    {
      allPostsByDate.length === 0 ? (
        <div class="flex items-center gap-4 mb-6">
          <div class="flex flex-col">
            <h2 class="text-primary text-2xl font-bold">404</h2>
            <p class="text-muted-foreground text-xs">No posts published yet.</p>
          </div>
        </div>
      ) : (
        <ul class="ruled-list">
          {allPostsByDate.map((post) => (
            <li >
              <PostPreview post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
