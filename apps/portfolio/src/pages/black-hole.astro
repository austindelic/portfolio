---
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import BaseHead from "../components/BaseHead.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import BlackHoleShader from "../components/BlackHoleShader";
---

<!doctype html>
<html lang="en" class="dark h-full bg-black">
  <head>
    <BaseHead
      title="Black Hole Shader | Austin Delic"
      description="Interactive Kerr-Newman black hole shader ported from Shadertoy."
    />
  </head>
  <body class="h-full overflow-hidden bg-black text-white selection:bg-cyan-700 selection:text-white">
    <main class="relative h-dvh w-screen overflow-hidden bg-black">
      <BlackHoleShader client:only="react" />

      <div class="pointer-events-none absolute inset-x-0 top-0 z-10 flex items-start justify-between gap-4 p-4 font-mono text-xs text-white/80 sm:p-6">
        <a
          href="/"
          class="pointer-events-auto border border-white/20 bg-black/55 px-3 py-2 text-white backdrop-blur-md transition-colors hover:border-white/50 hover:bg-black/75 focus:outline-none focus:ring-2 focus:ring-cyan-500"
        >
          ../
        </a>

        <div class="pointer-events-auto max-w-[min(32rem,calc(100vw-6rem))] border border-white/15 bg-black/45 px-3 py-2 text-right backdrop-blur-md">
          <h1 class="text-sm text-white">Black Hole</h1>
          <p class="mt-1 text-[11px] leading-4 text-white/55">
            Shadertoy wXdfzj by baopinshui. Bloom passes adapted from sonicether.
          </p>
        </div>
      </div>
    </main>
  </body>
</html>
