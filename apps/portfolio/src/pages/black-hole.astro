---
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import BaseHead from "../components/BaseHead.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro consumes this component in the template.
import BlackHoleShader from "../components/BlackHoleShader";
---

<!doctype html>
<html lang="en" class="dark h-full bg-black">
  <head>
    <BaseHead
      title="Black Hole Shader | Austin Delic"
      description="Interactive ASCII Kerr-Newman black hole shader ported from Shadertoy."
    />
  </head>
  <body class="h-full overflow-hidden bg-black text-white selection:bg-cyan-700 selection:text-white">
    <main class="relative h-dvh w-screen overflow-hidden bg-black">
      <BlackHoleShader
        quality="performance"
        maxDevicePixelRatio={0.85}
        sceneScale={0.3}
        prepassScale={0.25}
        bloomScale={0.25}
        timeScale={2}
        exposure={2}
        bloomStrength={0}
        temporalJitter={0}
        glyphPreset="custom"
        customGlyphs="voidCG08AA"
        textSize={9}
        brightness={0}
        contrast={1}
        animationMode="editor"
        animationRoute="/"
        animationAutoplay={false}
        initialCameraPosition={[11.256, 4.159, 18.44]}
        initialCameraForward={[-0.871, 0.49, 0.028]}
        initialUniverseSign={1}
        className="h-full w-full"
        client:only="react"
      />
    </main>
  </body>
</html>
