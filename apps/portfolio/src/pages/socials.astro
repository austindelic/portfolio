
---
import BaseLayout from "../layouts/BaseLayout.astro";

const socials: Array<{
	title: string;
	description?: string;
	href: string;
	badge?: string;
}> = [
	{
		title: "Portfolio",
		description: "austindelic.com",
		href: "https://austindelic.com",
	},
	{
		title: "GitHub",
		description: "@austindelic",
		href: "https://github.com/austindelic",
	},
	{
		title: "YouTube",
		description: "Austin Develops",
		href: "https://youtube.com/@austindevelops",
		badge: "new",
	},
	{
		title: "Instagram",
		description: "@austin.develops",
		href: "https://instagram.com/austin.develops",
	},
	{
		title: "TikTok",
		description: "@austin.develops",
		href: "https://tiktok.com/@austin.develops",
	},
	{
		title: "LinkedIn",
		description: "Austin Delic",
		href: "https://linkedin.com/in/austindelic",
	},
	{
		title: "Email",
		description: "austin@austindelic.com",
		href: "mailto:austin@austindelic.com",
	},
];
---

<BaseLayout navbarActiveItemID="socials">
  <section class="portfolio-section directory-panel" aria-labelledby="links-heading">
    <div class="section-label"><span>Social links</span><span>{String(socials.length).padStart(2, "0")}</span></div>
    <h1 id="links-heading" class="page-title">Austin Delic<span class="text-primary">.</span></h1>
    <ul class="ruled-list">
      {socials.map((item, index) => (
        <li><a class="social-row" href={item.href} target={item.href.startsWith("mailto:") ? undefined : "_blank"} rel={item.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}>
          <span class="row-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div><span class="row-title">{item.title}</span>{item.badge && <span class="small-badge">{item.badge}</span>}<p class="row-description">{item.description}</p></div>
          <span class="row-arrow" aria-hidden="true">↗</span>
        </a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
