
---
import { Globe } from "pixelarticons/react/Globe.js";
import { Code } from "pixelarticons/react/Code.js";
import { Video } from "pixelarticons/react/Video.js";
import { Camera } from "pixelarticons/react/Camera.js";
import { Music } from "pixelarticons/react/Music.js";
import { Briefcase } from "pixelarticons/react/Briefcase.js";
import { Mail } from "pixelarticons/react/Mail.js";
import portfolio from "../data/portfolio.json";
import BaseLayout from "../layouts/BaseLayout.astro";

const socials = portfolio.socials;
const icons = { Globe, Code, Video, Camera, Music, Briefcase, Mail };
---

<BaseLayout navbarActiveItemID="socials">
  <section class="portfolio-section directory-panel" aria-labelledby="links-heading">
    <div class="section-label"><span>Social links</span><span>{String(socials.length).padStart(2, "0")}</span></div>
    <h1 id="links-heading" class="page-title">{portfolio.profile.name}<span class="text-primary">.</span></h1>
    <ul class="ruled-list">
      {socials.map((item, index) => {
        const Icon = icons[item.icon as keyof typeof icons];
        return (
        <li><a class="social-row" href={item.href} target={item.href.startsWith("mailto:") ? undefined : "_blank"} rel={item.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}>
          <span class="row-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div><span class="row-title social-title"><Icon className="ui-icon" aria-hidden="true" />{item.title}</span>{item.badge && <span class="small-badge">{item.badge}</span>}<p class="row-description">{item.description}</p></div>

        </a></li>
      ); })}
    </ul>
  </section>
</BaseLayout>
