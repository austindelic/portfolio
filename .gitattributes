packages/black-hole/**/*.glsl text eol=lf
packages/black-hole/**/*.wgsl text eol=lf
packages/black-hole/**/*.json text eol=lf
# Asset hashes must be identical on every release platform.
apps/portfolio/src/data/*.json text eol=lf
apps/portfolio/src/content/blog/**/index.md text eol=lf
apps/portfolio/src/lib/ascii-analysis.ts text eol=lf
apps/portfolio/src/components/BlackHoleCore.ts text eol=lf
apps/tui/assets-manifest.json text eol=lf
apps/tui/core/assets/**/*.md text eol=lf
apps/tui/core/assets/*.json text eol=lf
apps/tui/core/tests/snapshots/*.txt text eol=lf -whitespace

# Bash also needs LF when invoked by the Windows release runner.
apps/tui/scripts/*.sh text eol=lf

# Binary assets must never undergo line-ending conversion.
*.pdf binary
*.woff2 binary
