{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "tsc -p tsconfig.tooling.json && npm --prefix apps/tui/release run check-types && turbo run check-types",
    "build:launcher": "tsx apps/tui/scripts/build-launcher.ts",
    "prepare:browser": "tsx tooling/prepare-browser.ts",
    "test:tooling": "tsx --test tooling/tests/*.test.ts"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "6.0.3",
    "tsx": "^4.20.6",
    "jiti": "^2.6.1",
    "@types/node": "^22.15.3",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/portfolio",
    "packages/*"
  ],
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/austindelic/portfolio.git"
  }
}
